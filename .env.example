# Copy to .env and fill in real values. Never commit .env.

# Supabase (Postgres) — Project Settings → Database → Connection string
# Local dev: use the "Direct connection" string (port 5432).
# Vercel/production: use the "Transaction pooler" string (port 6543) with
# ?pgbouncer=true appended — serverless functions need connection pooling.
DATABASE_URL=""

# Random signing secret for admin session JWTs. Generate a fresh one for
# production, e.g.: openssl rand -base64 32
JWT_SECRET=""

# Admin login credentials
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Cloudinary — image uploads from the admin panel. Both are public by
# design (unsigned upload preset), safe to expose to the browser.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
